# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only, never expose to the client/browser

# Cashfree
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
# Keep this false until your DSA/LSP + legal setup permits borrower-side charges.
CASHFREE_CHARGES_ENABLED=false
# "sandbox" while testing, "production" only once CASHFREE_CHARGES_ENABLED=true
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# Used to build the Cashfree return_url and canonical SEO URLs — your live
# domain, no trailing slash. Use https://loansaathi.online in production.
NEXT_PUBLIC_SITE_URL=https://loansaathi.online

# 2Factor.in — used for OTP login (custom flow, not via Supabase's phone auth
# since 2Factor isn't one of Supabase's built-in phone providers).
# Leave empty to run OTP in demo/stub mode (accepts 123456 as the OTP).
TWO_FACTOR_API_KEY=

# Long random string used to sign customer session cookies AND the
# short-lived "OTP verified" token used between OTP verification and
# password creation/reset. Generate one with: openssl rand -hex 32
CUSTOMER_SESSION_SECRET=

# Tawk.to live chat widget (Help page). Leave empty to hide the chat button.
NEXT_PUBLIC_TAWKTO_PROPERTY_ID=
NEXT_PUBLIC_TAWKTO_WIDGET_ID=

# Secret used to authorize the daily cron job that auto-rejects applications
# stuck pending for 3+ months (app/api/cron/expire-applications).
# Generate one with: openssl rand -hex 32
# Also add the same value in Vercel → Settings → Cron Jobs if prompted.
CRON_SECRET=
